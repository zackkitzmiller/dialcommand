{
  "editor.formatOnSave": true,
  "editor.rulers": [80],
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "black-formatter.args": ["--line-length", "80"],
  "black-formatter.importStrategy": "fromEnvironment"
}
